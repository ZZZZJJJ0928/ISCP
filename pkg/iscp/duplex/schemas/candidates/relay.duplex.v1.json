  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "$comment": "UTF-8 byte length is additionally limited to 256 by the strict wire prevalidator."
    },
    "bytes32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 43,
      "maxLength": 43,
      "$comment": "Must decode canonically to exactly 32 bytes; reject nonzero pad bits."
    },
    "uint64": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$",
      "maxLength": 20,
      "$comment": "Decimal value <= 18446744073709551615; zero forbidden except initial-auth closing generation."
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_frame_bytes",
        "max_envelope_bytes",
        "max_control_bytes",
        "max_ttl_seconds",
        "query_recovery_seconds"
      ],
      "properties": {
        "max_frame_bytes": {
          "const": 1114112
        },
        "max_envelope_bytes": {
          "const": 1048576
        },
        "max_control_bytes": {
          "const": 65536
        },
        "max_ttl_seconds": {
          "const": 86400
        },
        "query_recovery_seconds": {
          "const": 604800
        }
      }
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "$comment": "UTF-8 byte length <= 8192."
    },
    "receipt": {
      "$ref": "relay.acceptance.v1.json"
    },
    "proof": {
      "allOf": [
        {
          "$ref": "../json/device.proof.v2.json"
        },
        {
          "properties": {
            "domain_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "$comment": "UTF-8 byte length is additionally limited to 256 by the strict wire prevalidator."
            },
            "device_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "$comment": "UTF-8 byte length is additionally limited to 256 by the strict wire prevalidator."
            },
            "audience": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "$comment": "UTF-8 byte length is additionally limited to 256 by the strict wire prevalidator."
            },
            "challenge": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "minLength": 43,
              "maxLength": 43,
              "$comment": "Must decode canonically to exactly 32 bytes; reject nonzero pad bits."
            },
            "nonce": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "minLength": 22,
              "maxLength": 256
            },
            "issued_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "format": "date-time"
            },
            "signature": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "alg",
                "kid",
                "value"
              ],
              "properties": {
                "alg": {
                  "const": "Ed25519"
                },
                "kid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "$comment": "UTF-8 byte length is additionally limited to 256 by the strict wire prevalidator."
                },
                "value": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$",
                  "minLength": 86,
                  "maxLength": 86
                }
              }
            }
          }
        }
      ]
    },
    "envelope": {
      "allOf": [
        {
          "$ref": "../json/secure_envelope.v2.json"
        },
        {
          "properties": {
            "domain_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "$comment": "UTF-8 byte length is additionally limited to 256 by the strict wire prevalidator."
            },
            "message_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "$comment": "UTF-8 byte length is additionally limited to 256 by the strict wire prevalidator."
            },
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "$comment": "UTF-8 byte length is additionally limited to 256 by the strict wire prevalidator."
            },
            "sender_device_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "$comment": "UTF-8 byte length is additionally limited to 256 by the strict wire prevalidator."
            },
            "recipient_device_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "$comment": "UTF-8 byte length is additionally limited to 256 by the strict wire prevalidator."
            },
            "payload_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "$comment": "UTF-8 byte length is additionally limited to 256 by the strict wire prevalidator."
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "nonce": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "minLength": 16,
              "maxLength": 16
            },
            "ciphertext": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "route": {
              "properties": {
                "relay_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "$comment": "UTF-8 byte length is additionally limited to 256 by the strict wire prevalidator."
                },
                "ttl_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400
                }
              }
            }
          }
        }
      ]
    }
  }
}
