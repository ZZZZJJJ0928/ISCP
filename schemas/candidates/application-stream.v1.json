{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkclaw.local/protocol/application-stream.v1.schema.json",
  "title": "Optional generic application stream v1 candidate",
  "description": "Local internal-release candidate; not an ISCP Core wire change or upstream standard. Encrypted payloads are at most 65536 UTF-8 bytes. Reject duplicate keys, invalid UTF-8, and unpaired Unicode surrogates before JSON Schema validation. The application owns opaque body validation. Completion is the body of the ordinary response.",
  "oneOf": [
    {
      "$ref": "#/$defs/frame"
    },
    {
      "$ref": "#/$defs/cancel"
    },
    {
      "$ref": "#/$defs/invalidate"
    },
    {
      "$ref": "#/$defs/completion"
    }
  ],
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schema_version",
        "subscription_id",
        "stream_seq",
        "body"
      ],
      "properties": {
        "type": {
          "const": "iscp.application.stream.v1"
        },
        "schema_version": {
          "const": 1
        },
        "subscription_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "stream_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "body": {
          "type": "object"
        }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schema_version",
        "subscription_id",
        "action",
        "latest_open_at"
      ],
      "properties": {
        "type": {
          "const": "iscp.application.stream.control.v1"
        },
        "schema_version": {
          "const": 1
        },
        "subscription_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "action": {
          "const": "cancel"
        },
        "latest_open_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "invalidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schema_version",
        "subscription_id",
        "action",
        "body"
      ],
      "properties": {
        "type": {
          "const": "iscp.application.stream.control.v1"
        },
        "schema_version": {
          "const": 1
        },
        "subscription_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "action": {
          "const": "invalidate"
        },
        "body": {
          "type": "object"
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "last_stream_seq",
        "reason"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "last_stream_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "enum": [
            "terminal",
            "renew",
            "canceled",
            "reset",
            "auth_expired",
            "gap",
            "preview_unavailable"
          ]
        }
      }
    }
  }
}
