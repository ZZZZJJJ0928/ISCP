{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkclaw.local/protocol/execution-stream.v1.schema.json",
  "title": "SparkClaw internal execution answer stream v1",
  "description": "Opaque body binding for matched internal release. Offsets are UTF-8 bytes; delta length and full resulting text digest require stateful validation. Controls are outside text sequencing. Duplicate keys, unpaired surrogates and invalid raw UTF-8 must be rejected before schema validation.",
  "oneOf": [
    {
      "$ref": "#/$defs/delta"
    },
    {
      "$ref": "#/$defs/snapshot_begin"
    },
    {
      "$ref": "#/$defs/snapshot_chunk"
    },
    {
      "$ref": "#/$defs/snapshot_end"
    },
    {
      "$ref": "#/$defs/state"
    },
    {
      "$ref": "#/$defs/invalidate"
    }
  ],
  "$defs": {
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch",
        "generation",
        "revision",
        "offset",
        "content_digest"
      ],
      "properties": {
        "epoch": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "open": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "input_digest",
        "latest_open_at"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "latest_open_at": {
          "type": "string",
          "format": "date-time"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "request_id",
        "input_digest",
        "epoch",
        "generation",
        "revision",
        "from_offset",
        "to_offset",
        "text",
        "content_digest"
      ],
      "properties": {
        "kind": {
          "const": "delta"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "epoch": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "from_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "to_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]*$"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "snapshot_begin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "request_id",
        "input_digest",
        "epoch",
        "generation",
        "revision",
        "snapshot_id",
        "total_bytes",
        "content_digest"
      ],
      "properties": {
        "kind": {
          "const": "snapshot_begin"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "epoch": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "snapshot_chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "request_id",
        "input_digest",
        "epoch",
        "generation",
        "revision",
        "snapshot_id",
        "offset",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "snapshot_chunk"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "epoch": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]*$"
        }
      }
    },
    "snapshot_end": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "request_id",
        "input_digest",
        "epoch",
        "generation",
        "revision",
        "snapshot_id",
        "total_bytes",
        "content_digest"
      ],
      "properties": {
        "kind": {
          "const": "snapshot_end"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "epoch": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "request_id",
        "input_digest",
        "epoch",
        "generation",
        "revision",
        "state"
      ],
      "properties": {
        "kind": {
          "const": "state"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "epoch": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "accepted",
            "running",
            "approval_pending",
            "browser_login_blocked",
            "completed",
            "failed",
            "unknown",
            "delivered",
            "delivery_expired"
          ]
        }
      }
    },
    "invalidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "request_id",
        "input_digest",
        "epoch",
        "generation",
        "revision",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "invalidate"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "epoch": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reason": {
          "enum": [
            "reset",
            "failed",
            "unknown",
            "delivered",
            "delivery_expired",
            "revoked",
            "closed",
            "preview_unavailable"
          ]
        }
      }
    }
  }
}
